---
// src/components/CaseStudyCard.astro
import type { CaseStudy } from '../types';

export interface Props {
  caseStudy: CaseStudy;
}

const { caseStudy } = Astro.props;
const imageUrl = caseStudy.metadata?.featured_image?.imgix_url;
const industry = caseStudy.metadata?.industry;
const costSavings = caseStudy.metadata?.cost_savings;
---

<div class="glass-dark rounded-2xl overflow-hidden transform hover:scale-105 hover:shadow-2xl hover:shadow-accent-500/30 transition-all duration-500 group">
  {imageUrl && (
    <div class="relative h-56 overflow-hidden">
      <img
        src={`${imageUrl}?w=800&h=400&fit=crop&auto=format,compress`}
        alt={caseStudy.title}
        class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
        width="400"
        height="200"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-secondary-900 via-transparent to-transparent opacity-60"></div>
      {costSavings && (
        <div class="absolute top-4 right-4">
          <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold bg-gradient-to-r from-green-400 to-emerald-500 text-white shadow-xl animate-glow">
            {costSavings}
          </span>
        </div>
      )}
    </div>
  )}
  
  <div class="p-8">
    {industry && (
      <div class="mb-3">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold glass text-gray-300">
          {industry}
        </span>
      </div>
    )}
    
    <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-accent-400 group-hover:to-primary-400 group-hover:bg-clip-text transition-all duration-300">
      {caseStudy.title}
    </h3>
    
    <p class="text-gray-300 mb-6 font-medium">
      {caseStudy.metadata?.client_name}
    </p>
    
    <a
      href={`/case-studies/${caseStudy.slug}`}
      class="inline-flex items-center text-accent-400 hover:text-primary-400 font-semibold group/link transition-colors duration-300"
    >
      Read Case Study
      <svg class="ml-2 w-5 h-5 transform group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </a>
  </div>
</div>