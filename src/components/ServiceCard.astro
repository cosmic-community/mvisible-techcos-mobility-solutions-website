---
// src/components/ServiceCard.astro
import type { Service } from '../types';

export interface Props {
  service: Service;
}

const { service } = Astro.props;
const imageUrl = service.metadata?.featured_image?.imgix_url;
const category = service.metadata?.service_category?.value || 'Service';
---

<div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300">
  {imageUrl && (
    <div class="relative h-48 overflow-hidden">
      <img
        src={`${imageUrl}?w=800&h=400&fit=crop&auto=format,compress`}
        alt={service.title}
        class="w-full h-full object-cover"
        width="400"
        height="200"
      />
      <div class="absolute top-4 left-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-primary-100 text-primary-800">
          {category}
        </span>
      </div>
    </div>
  )}
  
  <div class="p-6">
    <h3 class="text-xl font-bold text-gray-900 mb-3">
      {service.metadata?.service_name || service.title}
    </h3>
    
    <div class="text-gray-600 mb-4 prose prose-sm max-w-none" set:html={service.metadata?.description} />
    
    {service.metadata?.pricing_model && (
      <div class="mb-4">
        <span class="text-sm font-medium text-gray-500">Pricing: </span>
        <span class="text-sm text-gray-900">{service.metadata.pricing_model}</span>
      </div>
    )}
    
    <a
      href={`/services/${service.slug}`}
      class="inline-flex items-center text-primary-600 hover:text-primary-700 font-medium"
    >
      Learn More
      <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>