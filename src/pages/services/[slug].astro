---
// src/pages/services/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { getServices, getService } from '../../lib/cosmic';
import type { Service } from '../../types';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map(service => ({
    params: { slug: service.slug },
  }));
}

const { slug } = Astro.params;
const service = await getService(slug as string) as Service | null;

if (!service) {
  return Astro.redirect('/404');
}

const imageUrl = service.metadata?.featured_image?.imgix_url;
const category = service.metadata?.service_category?.value || 'Service';
const pricingModel = service.metadata?.pricing_model;
---

<Layout title={`${service.title} - MVisible TechCos`} description={service.metadata?.service_name}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary-600 to-primary-800 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="mb-4">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-white text-primary-800">
            {category}
          </span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-6">
          {service.metadata?.service_name || service.title}
        </h1>
        {pricingModel && (
          <p class="text-xl text-primary-100">
            Pricing: {pricingModel}
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          {imageUrl && (
            <div class="mb-8 rounded-lg overflow-hidden shadow-lg">
              <img
                src={`${imageUrl}?w=1600&h=800&fit=crop&auto=format,compress`}
                alt={service.title}
                class="w-full h-auto"
                width="800"
                height="400"
              />
            </div>
          )}

          <div class="prose prose-lg max-w-none mb-12">
            <div set:html={service.metadata?.description} />
          </div>

          {service.metadata?.key_benefits && (
            <div class="bg-gray-50 rounded-lg p-8">
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Key Benefits</h2>
              <div class="prose prose-lg max-w-none">
                <Fragment set:html={service.metadata.key_benefits} />
              </div>
            </div>
          )}
        </div>

        <div class="lg:col-span-1">
          <div class="bg-primary-50 rounded-lg p-8 sticky top-24">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">Get Started Today</h3>
            <p class="text-gray-700 mb-6">
              Ready to optimize your mobility strategy and start saving costs?
            </p>
            <a
              href="#contact"
              class="block w-full text-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 transition-colors mb-4"
            >
              Schedule Consultation
            </a>
            <a
              href="/services"
              class="block w-full text-center px-6 py-3 border border-gray-300 text-base font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 transition-colors"
            >
              View All Services
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>